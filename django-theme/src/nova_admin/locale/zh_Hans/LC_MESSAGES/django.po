#: templates/nova_admin/theme_switcher.html
msgctxt "Nova Admin"
msgid "Nova auto"
msgstr "Nova 自动（跟随系统）"

msgctxt "Nova Admin"
msgid "Welcome back"
msgstr "欢迎回来"

msgctxt "Nova Admin"
msgid "Sign in to your management workspace."
msgstr "登录你的管理工作空间。"

msgctxt "Nova Admin"
msgid "Use the account assigned by your site administrator."
msgstr "请使用站点管理员分配的账号。"

msgctxt "Nova Admin"
msgid "Your workspace."
msgstr "回到你的工作空间"

msgctxt "Nova Admin"
msgid "Everything in order."
msgstr "让管理井然有序"

msgctxt "Nova Admin"
msgid "A clear place for content, people and everyday work."
msgstr "内容、成员与日常事务，在这里有序展开。"

msgctxt "Nova Admin"
msgid "A focused start to your day."
msgstr "从容开始，新一天的工作。"

msgctxt "Nova Admin"
msgid ""
"The verification code is incorrect or expired. Please try the new image."
msgstr "验证码不正确或已过期，请输入新图片中的字符。"

msgctxt "Nova Admin"
msgid ""
"If you cannot use this challenge, contact your administrator for an "
"alternative sign-in method."
msgstr "如果无法完成此验证，请联系管理员使用其他登录方式。"

msgctxt "Nova Admin"
msgid "Verification code"
msgstr "验证码"

msgctxt "Nova Admin"
msgid ""
"Enter the characters shown in the image. Letters are not case-sensitive."
msgstr "请输入图片中的字符，不区分大小写。"

msgctxt "Nova Admin"
msgid "Loading a new verification image…"
msgstr "正在加载新验证码…"

msgctxt "Nova Admin"
msgid "New verification image ready."
msgstr "新验证码已准备好。"

msgctxt "Nova Admin"
msgid "Could not load a new image. Reload this page before signing in."
msgstr "无法加载新验证码，请刷新本页面后再登录。"

msgctxt "Nova Admin"
msgid ""
"The verification image did not load. Try a new image or contact your "
"administrator."
msgstr "验证码图片加载失败，请换一张或联系管理员。"

msgctxt "Nova Admin"
msgid ""
"Verification challenge. Enter the characters shown, or use the available "
"alternative."
msgstr "图形验证码，请输入图中字符，或使用可用的其他验证方式。"

msgctxt "Nova Admin"
msgid "Listen to verification audio"
msgstr "收听验证码"

msgctxt "Nova Admin"
msgid "New image"
msgstr "换一张"

msgctxt "Nova Admin"
msgid "Alternative sign-in help"
msgstr "其他登录方式帮助"

msgctxt "Nova Admin"
msgid ""
"Reload this page for a new image. Your sign-in still works without "
"JavaScript."
msgstr "刷新本页面可获取新验证码。不启用JavaScript也可通过服务端验证登录。"

