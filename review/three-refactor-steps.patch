+    step = Math.max(1, step - 1);
+    api.renderView();
+    return;
+  }
+  if (action.startsWith('toast-'))
+    return api.toast(
+      {
+        success: '演示操作已成功完成',
+        error: '保存失败示例，输入内容已保留',
