+  if (p && !p.disabled) {
+    page = Number(p.dataset.newsPage);
+    refresh(`[data-news-page="${page}"]`);
+    return;
+  }
+  const b = e.target.closest('[data-news]');
+  if (!b) return;
+  const a = b.dataset.news;
+  if (a === 'sort') {
+    sort = sort === 'desc' ? 'asc' : 'desc';
+    page = 1;
+    refresh('[data-news="sort"]');
+    return;
+  }
+  if (a === 'reset') {
+    query = '';
+    category = '全部栏目';
+    status = '全部状态';
+    page = 1;
+    selected.clear();
+    sync();
+    api.renderView();
+    document.querySelector('#news-search')?.focus();
+    return;
+  }
+  if (a === 'clear') {
+    selected.clear();
+    refresh();
+    return;
+  }
+  if (['publish', 'archive'].includes(a)) {
+    const target = a === 'publish' ? '已发布' : '归档',
+      chosen = records.filter((r) => selected.has(r.id));
+    api.openOverlay(
+      `<section class="modal" role="dialog" aria-modal="true" aria-labelledby="news-batch-title"><h2 id="news-batch-title">${target} ${chosen.length} 篇演示内容？</h2><p>只更新当前浏览器中的模拟状态。</p><ul class="batch-preview">${chosen.map((r) => `<li>${esc(r.title)}</li>`).join('')}</ul><div class="modal-actions"><button class="btn" data-action="close">取消</button><button class="btn primary" data-news="confirm" data-news-target="${target}">确认更新</button></div></section>`,
+      true,
+    );
+    return;
+  }
+  if (a === 'confirm') {
+    const target = b.dataset.newsTarget;
+    if (!['已发布', '归档'].includes(target)) return;
+    const next = records.map((r) => (selected.has(r.id) ? { ...r, status: target } : r));
+    if (!api.save('nova-news', next)) return;
+    records = next;
+    api.addAuditEvent('新闻批量更新', `${selected.size} 篇内容 → ${target}`);
+    selected.clear();
+    api.closeOverlay(true);
+    refresh();
+    api.toast('演示新闻状态已更新');
+  }
+}
+function input(e) {
+  if (e.target.id === 'news-search') {
+    query = e.target.value;
+    page = 1;
+    selected.clear();
+    refresh();
+  }
+}
+function change(e) {
+  if (['news-category', 'news-status'].includes(e.target.id)) {
+    if (e.target.id === 'news-category') category = e.target.value;
+    else status = e.target.value;
+    page = 1;
+    selected.clear();
+    refresh();
+  }
+  if (e.target.matches('.news-check')) {
+    e.target.checked
+      ? selected.add(Number(e.target.value))
+      : selected.delete(Number(e.target.value));
+    refresh(
+      `.${e.target.closest('.mobile-news-cards') ? 'mobile-news-cards' : 'news-table-wrap'} .news-check[value="${e.target.value}"]`,
+    );
+  }
+  if (['news-all', 'news-mobile-all'].includes(e.target.id)) {
+    filtered()
+      .slice((page - 1) * pageSize, page * pageSize)
+      .forEach((r) => (e.target.checked ? selected.add(r.id) : selected.delete(r.id)));
+    refresh('#' + e.target.id);
+  }
+}
