+}
+export function renderAudit() {
+  const { icon, button } = helpers();
+  let rows = audit.filter((a) => auditFilter === '全部结果' || a.status === auditFilter);
+  return `<div class="notice">${icon('history')}当前为本地操作轨迹，含初始示例。真实审计日志必须由 Django 在服务端可靠记录。</div><section class="panel"><div class="user-toolbar"><div><h2>最近操作</h2><p class="lab-copy">本次演示中的新增、编辑、批量操作会追加到这里</p></div><span class="spacer"></span><select id="audit-filter" aria-label="按操作结果筛选">${['全部结果', '成功', '已拦截', '失败'].map((s) => `<option ${s === auditFilter ? 'selected' : ''}>${s}</option>`).join('')}</select></div><div class="table-scroll"><table class="audit-table"><thead><tr><th>操作</th><th>关联资源</th><th>操作者</th><th>结果</th><th>发生时间</th><th>详情</th></tr></thead><tbody>${rows.map((a) => `<tr><td><strong>${a.type}</strong><small class="audit-id">${a.id}</small></td><td>${api.esc(a.resource)}</td><td>${a.actor}</td><td><span class="pill ${a.status === '成功' ? 'status-normal' : a.status === '失败' ? 'status-error' : 'status-pending'}">${a.status}</span></td><td class="muted">${a.time}</td><td><button class="icon-button" data-audit-id="${a.id}" aria-label="查看 ${a.id}">${icon('chevron')}</button></td></tr>`).join('')}</tbody></table></div><div class="table-footer"><span>共 ${rows.length} 条记录 · 最多保留最近 60 条本地操作</span><span>全部为演示数据</span></div></section>`;
+}
+function detailDrawer(id) {
+  const { state, esc, icon, openOverlay, person } = helpers();
+  let u = state.users.find((u) => u.id === id);
+  if (!u) return;
+  openOverlay(
+    `<section class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title"><div class="drawer-header"><div><div class="eyebrow">MEMBER DETAILS</div><h2 id="drawer-title">成员详情</h2><p>演示资料 · 不连接真实账户</p></div><button class="icon-button" data-action="close" aria-label="关闭详情">${icon('close')}</button></div><div class="drawer-content"><div class="detail-profile">${person(u)}<span class="pill ${u.status === '正常' ? 'status-normal' : ''}">${u.status}</span></div><dl class="detail-list"><div><dt>成员编号</dt><dd>NOVA-${String(u.id).padStart(4, '0')}</dd></div><div><dt>所属团队</dt><dd>${u.team}</dd></div><div><dt>角色</dt><dd>${u.role}</dd></div><div><dt>加入时间</dt><dd>${u.joined}</dd></div><div><dt>电子邮箱</dt><dd>${esc(u.email)}</dd></div></dl><h3 style="margin-top:28px">最近活动 · 示例</h3><div class="timeline"><div><i></i><strong>资料已更新</strong><p>完善团队信息</p><small>2026-10-01 09:42</small></div><div><i></i><strong>角色已分配</strong><p>${u.role} · ${u.team}</p><small>${u.joined}</small></div><div><i></i><strong>加入工作空间</strong><p>演示账户创建成功</p><small>${u.joined}</small></div></div></div><div class="drawer-footer"><button class="btn" data-action="close">关闭</button><button class="btn primary" data-edit="${u.id}">${icon('edit')}编辑资料</button></div></section>`,
+  );
+}
+function auditDrawer(id) {
+  let a = audit.find((a) => a.id === id);
+  if (!a) return;
+  api.openOverlay(
+    `<section class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title"><div class="drawer-header"><div><div class="eyebrow">AUDIT DETAIL</div><h2 id="drawer-title">操作详情</h2></div><button class="icon-button" data-action="close" aria-label="关闭操作详情">${api.icon('close')}</button></div><div class="drawer-content"><span class="pill ${a.status === '成功' ? 'status-normal' : 'status-pending'}">${a.status}</span><dl class="detail-list"><div><dt>事件编号</dt><dd>${a.id}</dd></div><div><dt>操作类型</dt><dd>${a.type}</dd></div><div><dt>关联资源</dt><dd>${api.esc(a.resource)}</dd></div><div><dt>操作者</dt><dd>${a.actor}</dd></div><div><dt>记录时间</dt><dd>${a.time}</dd></div></dl><h3 style="margin-top:25px">事件说明</h3><p class="lab-copy">${api.esc(a.detail)}</p><div class="notice" style="margin-top:25px">${api.icon('circle')}这是浏览器端演示记录，不能作为真实安全审计证据。</div></div><div class="drawer-footer"><button class="btn primary" data-action="close">完成</button></div></section>`,
+  );
+}
+function onClick(e) {
+  let t = e.target.closest('[data-lab-tab]');
+  if (t) {
+    tab = t.dataset.labTab;
+    api.renderView();
+    return;
+  }
+  let tag = e.target.closest('[data-tag]');
+  if (tag) {
+    if (formTags.has(tag.dataset.tag)) {
+      if (formTags.size === 1) {
+        api.toast('至少保留一个协作标签');
+        return;
+      }
+      formTags.delete(tag.dataset.tag);
+    } else formTags.add(tag.dataset.tag);
+    tag.classList.toggle('selected', formTags.has(tag.dataset.tag));
+    tag.setAttribute('aria-pressed', formTags.has(tag.dataset.tag));
