+  return `<div class="boundary-state ${surface}">${icon(info[0])}<h3>${info[1]}</h3><p>${info[2]}</p>${labButton(info[3], surface === 'forbidden' ? 'go-users' : 'retry', true)}</div>`;
+}
+function workflow() {
